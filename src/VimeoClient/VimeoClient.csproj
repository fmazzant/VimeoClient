<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net472;net481;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <PackageId>Mafesoft.VimeoClient</PackageId>
    <Version>3.4.0.3</Version>
    <Authors>Federico Mazzanti</Authors>
    <Company>Federico Mazzanti</Company>
    <Description>Extensible .NET wrapper for the Vimeo API 3.4: every operation of the Vimeo API 3.4 OpenAPI specification, with typed methods, models and parameters, and pagination of the lists (Pagination&lt;T&gt;).</Description>
    <Copyright>Copyright (c) 2020 Federico Mazzanti</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/fmazzant/VimeoClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fmazzant/VimeoClient</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>vimeo, vimeo-client, c-sharp, dotnet-standard, http-client, restclient, mafe, json, rest, fluent, mafesoft</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.VimeoClient</RootNamespace>
  </PropertyGroup>

  <!-- XML documentation: published with the package, IntelliSense shows it to the users of the package -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1587: the MIT license header at the top of each file is an XML comment not placed on a language element -->
    <NoWarn>$(NoWarn);CS1587</NoWarn>
  </PropertyGroup>

  <!-- Symbols and SourceLink: the users of the package can step into the library code while debugging -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic build (normalized source paths) when building in GitHub Actions -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mafesoft.RestClient" Version="3.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
