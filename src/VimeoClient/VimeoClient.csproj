<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net472;net481;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <PackageId>Mafesoft.VimeoClient</PackageId>
    <Version>3.4.0</Version>
    <Authors>Federico Mazzanti</Authors>
    <Company>Federico Mazzanti</Company>
    <Description>VimeoClient library provides a simple connector to Vimeo REST services (Vimeo API 3.4).</Description>
    <Copyright>Copyright (c) 2020 Federico Mazzanti</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/fmazzant/VimeoClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fmazzant/VimeoClient</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>vimeo, vimeo-client, c-sharp, dotnet-standard, http-client, restclient, mafe, json, rest, fluent, mafesoft</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.VimeoClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Body\Category\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mafe.RestClient" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
